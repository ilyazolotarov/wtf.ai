S3_API_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_TRIPLOGS_BUCKET_NAME=wtf-ai-triplogs

# This project's servers and Sentry account (app.config.js, README → Configuration). In CI: repository variables of
