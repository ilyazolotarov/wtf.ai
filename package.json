{
  "name": "wtf.ai",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo/ui": "~57.0.21",
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
