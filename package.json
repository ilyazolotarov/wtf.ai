    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "replay": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/cli.ts",
    "replay:bench": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/bench.ts",
    "replay:spoof": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/spoof-bench.ts",
    "replay:view": "node --watch --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/viewer/server.ts",
    "replay:graph": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/graph.ts",
    "replay:truth": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/truth.ts",
    "replay:mm": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/mapmatch.ts",
    "replay:places": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/places.ts",
    "replay:crossings": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/crossings.ts",
    "replay:parity": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/parity.ts",
    "replay:compass": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/compass-report.ts",
    "replay:sim": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/simulate.ts",
    "route": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/route.ts",
    "route:bench": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/route-bench.ts",
    "route:sim": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/guidance-sim.ts",
    "search": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/search.ts",
    "replay:doubt": "node --experimental-transform-types --no-warnings --import ./tools/replay/register.mjs tools/replay/doubt-bench.ts"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.58.4": true
  }
}
