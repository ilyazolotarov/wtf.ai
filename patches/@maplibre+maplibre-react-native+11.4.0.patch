+package org.maplibre.reactnative.components.location
+
+import android.graphics.Bitmap
+import android.graphics.BlurMaskFilter
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RadialGradient
+import android.graphics.RectF
+import android.graphics.Shader
+import android.util.DisplayMetrics
+import org.json.JSONObject
+import kotlin.math.ceil
+import kotlin.math.max
+
+/**
+ * wtf.ai: the app's dot as a style image for the LocationComponent (GPS render mode turns it by the course): a
+ * halo under it, the heading cone pointing up, then the dot's edge, ring and fill. Colours 0xAARRGGBB, sizes in dp.
+ */
+object AppPuck {
+    const val IMAGE = "wtf-ai-puck"
+
+    private class Style(
+        private val json: JSONObject?,
+    ) {
+        private fun color(
+            key: String,
+            fallback: Int,
+        ): Int = json?.optLong(key, fallback.toLong())?.toInt() ?: fallback
+
+        private fun num(
+            key: String,
+            fallback: Double,
+        ): Double = json?.optDouble(key, fallback) ?: fallback
+
+        val dot = color("dot", 0xFF0A84FF.toInt())
+        val doubt = color("doubt", 0xFFB47D38.toInt())
+        val bg = color("bg", Color.WHITE)
+        val ring = color("ring", Color.WHITE)
+        val edge = color("edge", 0xE6000000.toInt())
+        val halo = color("halo", dot)
+        val haloOpacity = num("haloOpacity", 0.0)
+        val r = num("r", 8.0)
+        val ringWidth = num("ringWidth", 3.5)
+        val edgeWidth = num("edgeWidth", 1.5)
+        val haloR = num("haloR", 0.0)
+        val coneR = num("coneR", 34.0)
+        val coneHalfDeg = num("coneHalfDeg", 28.0)
+        val coneOpacity = num("coneOpacity", 0.32)
+        val coneEdge = num("coneEdge", 1.5)
+        val coneRing = num("coneRing", 0.0)
+    }
+
+    private fun withAlpha(
+        color: Int,
+        opacity: Double,
+    ): Int = (color and 0x00FFFFFF) or ((opacity.coerceIn(0.0, 1.0) * 255).toInt() shl 24)
+
+    /** The dot's colour, or the doubt colour, for the LocationComponent's own accuracy circle. */
+    fun tint(
+        styleJson: JSONObject?,
+        doubt: Boolean,
+    ): Int {
+        val s = Style(styleJson)
+        return if (doubt) s.doubt else s.dot
+    }
+
+    /** The puck, or a blank of the same size when hidden (the layer keeps its place). */
+    fun bitmap(
+        metrics: DisplayMetrics,
+        styleJson: JSONObject?,
+        doubt: Boolean,
+        hidden: Boolean,
+        withCone: Boolean,
+    ): Bitmap {
+        val s = Style(styleJson)
+        val d = metrics.density
+        val half = max(s.coneR, max(s.haloR, s.r + s.ringWidth + s.edgeWidth))
+        val side = ceil(2 * half * d).toInt().coerceAtLeast(1)
+        val bitmap = Bitmap.createBitmap(metrics, side, side, Bitmap.Config.ARGB_8888)
+        if (hidden) return bitmap
+        val canvas = Canvas(bitmap)
+        val c = side / 2f
+        val tint = if (doubt) s.doubt else s.dot
+        val fill = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+        val stroke = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeJoin = Paint.Join.ROUND
+        }
+        if (withCone && s.coneR > 0) {
+            val radius = (s.coneR * d).toFloat()
+            val sector = Path().apply {
+                moveTo(c, c)
+                arcTo(RectF(c - radius, c - radius, c + radius, c + radius), (-90 - s.coneHalfDeg).toFloat(), (2 * s.coneHalfDeg).toFloat())
+                close()
+            }
+            if (s.coneEdge > 0) {
+                stroke.color = s.edge
+                stroke.strokeWidth = (2 * s.coneEdge * d).toFloat()
+                canvas.drawPath(sector, stroke)
+            }
+            if (s.coneRing > 0) {
+                stroke.color = if (doubt) s.doubt else s.ring
+                stroke.strokeWidth = (2 * s.coneRing * d).toFloat()
+                canvas.drawPath(sector, stroke)
+            }
+            fill.color = withAlpha(tint, s.coneOpacity)
+            canvas.drawPath(sector, fill)
+        }
+        val outer = ((s.r + s.ringWidth + s.edgeWidth) * d).toFloat()
+        // The dot's soft shadow (the app's: black at 22 %, blurred, 2 dp down), then the halo fading out over its outer
+        // part (the app's `circle-blur`), trusted only; in doubt the fill is the theme's background in the doubt ring.
+        val shadow = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = withAlpha(Color.BLACK, 0.22)
+            maskFilter = BlurMaskFilter(2.5f * d, BlurMaskFilter.Blur.NORMAL)
+        }
+        canvas.drawCircle(c, c + 2 * d, outer + 2 * d, shadow)
+        if (!doubt && s.haloR > 0 && s.haloOpacity > 0) {
+            val glow = withAlpha(s.halo, s.haloOpacity)
+            val haloR = (s.haloR * d).toFloat()
+            val haloPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                shader = RadialGradient(c, c, haloR, intArrayOf(glow, glow, withAlpha(s.halo, 0.0)), floatArrayOf(0f, 0.6f, 1f), Shader.TileMode.CLAMP)
+            }
+            canvas.drawCircle(c, c, haloR, haloPaint)
+        }
+        fill.color = s.edge
+        canvas.drawCircle(c, c, outer, fill)
+        fill.color = if (doubt) s.doubt else s.ring
+        canvas.drawCircle(c, c, ((s.r + s.ringWidth) * d).toFloat(), fill)
+        fill.color = if (doubt) s.bg else s.dot
+        canvas.drawCircle(c, c, (s.r * d).toFloat(), fill)
+        return bitmap
+    }
+}
