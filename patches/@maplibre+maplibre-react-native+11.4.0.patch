++ (instancetype)fromDictionary:(NSDictionary *)dict {
+  MLRNAppPuckStyle *s = [[MLRNAppPuckStyle alloc] init];
+  s.dot = MLRNColorFromARGB(dict[@"dot"], [UIColor colorWithRed:0.04 green:0.52 blue:1 alpha:1]);
+  s.doubt = MLRNColorFromARGB(dict[@"doubt"], [UIColor colorWithRed:0.71 green:0.49 blue:0.22 alpha:1]);
+  s.bg = MLRNColorFromARGB(dict[@"bg"], [UIColor whiteColor]);
+  s.ring = MLRNColorFromARGB(dict[@"ring"], [UIColor whiteColor]);
+  s.edge = MLRNColorFromARGB(dict[@"edge"], [UIColor colorWithWhite:0 alpha:0.9]);
+  s.halo = MLRNColorFromARGB(dict[@"halo"], s.dot);
+  s.haloOpacity = MLRNNumber(dict[@"haloOpacity"], 0);
+  s.r = MLRNNumber(dict[@"r"], 8);
+  s.ringWidth = MLRNNumber(dict[@"ringWidth"], 3.5);
+  s.edgeWidth = MLRNNumber(dict[@"edgeWidth"], 1.5);
+  s.haloR = MLRNNumber(dict[@"haloR"], 0);
+  s.coneR = MLRNNumber(dict[@"coneR"], 34);
+  s.coneHalfDeg = MLRNNumber(dict[@"coneHalfDeg"], 28);
+  s.coneOpacity = MLRNNumber(dict[@"coneOpacity"], 0.32);
+  s.coneEdge = MLRNNumber(dict[@"coneEdge"], 1.5);
+  s.coneRing = MLRNNumber(dict[@"coneRing"], 0);
+  return s;
+}
