+// wtf.ai: the app's own fused position shown as MapLibre's user location, so the dot and the follow camera animate
+// on MapLibre's render thread between the app's updates (UI-SPEC §6.2). `MLRNFedLocationManager` stands in for
+// CoreLocation and delivers what the app feeds; `MLRNAppPuckView` draws the dot the way the app's GeoJSON puck did.
+#import <CoreLocation/CoreLocation.h>
+#import <MapLibre/MapLibre.h>
+#import <UIKit/UIKit.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+/** A location manager with no device behind it: the map gets the locations the app hands it. */
+@interface MLRNFedLocationManager : NSObject <MLNLocationManager>
+- (void)feed:(CLLocation *)location;
+@end
+
+/** The puck's look, from the app's style JSON (colours as 0xAARRGGBB, sizes in points, angles in degrees). */
+@interface MLRNAppPuckStyle : NSObject
+@property (nonatomic, strong) UIColor *dot;
+@property (nonatomic, strong) UIColor *doubt;
+/** The dot's fill in doubt (the theme's background), inside the doubt-coloured ring. */
+@property (nonatomic, strong) UIColor *bg;
+@property (nonatomic, strong) UIColor *ring;
+@property (nonatomic, strong) UIColor *edge;
+@property (nonatomic, strong) UIColor *halo;
+@property (nonatomic, assign) double haloOpacity;
+@property (nonatomic, assign) double r;
+@property (nonatomic, assign) double ringWidth;
+@property (nonatomic, assign) double edgeWidth;
+@property (nonatomic, assign) double haloR;
+@property (nonatomic, assign) double coneR;
+@property (nonatomic, assign) double coneHalfDeg;
+@property (nonatomic, assign) double coneOpacity;
+@property (nonatomic, assign) double coneEdge;
+@property (nonatomic, assign) double coneRing;
++ (instancetype)fromDictionary:(nullable NSDictionary *)dict;
+@end
+
+/** The dot with its ring and edge, a halo under it, and the heading cone, turned by the course against the map. */
+@interface MLRNAppPuckView : MLNUserLocationAnnotationView
+@property (nonatomic, strong) MLRNAppPuckStyle *style;
+/** Without trusted GPS the dot is drawn in the doubt colour. */
+@property (nonatomic, assign) BOOL doubt;
+/** The dot gives way (standing on the drawn car). */
+@property (nonatomic, assign) BOOL concealed;
+/** No cone when the heading is unknown. */
+@property (nonatomic, assign) BOOL showsCone;
+- (instancetype)initWithStyle:(MLRNAppPuckStyle *)style;
+@end
+
+NS_ASSUME_NONNULL_END
