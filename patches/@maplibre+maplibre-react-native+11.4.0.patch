+/** The accuracy circle at most this many points across; beyond, the fill alone would tint the whole screen. */
+static CGFloat const MLRN_ACCURACY_MAX_PT = 4000;
+
+@implementation MLRNAppPuckView {
+  CAShapeLayer *_accuracyFill;
+  CAShapeLayer *_accuracyLine;
+  CALayer *_cone;
+  CAShapeLayer *_coneFill;
+  CAShapeLayer *_coneEdge;
+  CAShapeLayer *_coneRing;
+  CAShapeLayer *_shadow;
+  CAGradientLayer *_halo;
+  CAShapeLayer *_edge;
+  CAShapeLayer *_ring;
+  CAShapeLayer *_dot;
+  CGFloat _accuracyRadiusPt;
+}
+
+- (instancetype)initWithStyle:(MLRNAppPuckStyle *)style {
+  double side = 2 * MAX(style.coneR, MAX(style.haloR, style.r + style.ringWidth + style.edgeWidth));
+  if (self = [super initWithFrame:CGRectMake(0, 0, side, side)]) {
+    _showsCone = YES;
+    self.userInteractionEnabled = NO;
+    _accuracyFill = [CAShapeLayer layer];
+    _accuracyLine = [CAShapeLayer layer];
+    _accuracyLine.fillColor = nil;
+    [self.layer addSublayer:_accuracyFill];
+    [self.layer addSublayer:_accuracyLine];
+    _cone = [CALayer layer];
+    _coneFill = [CAShapeLayer layer];
+    _coneEdge = [CAShapeLayer layer];
+    _coneRing = [CAShapeLayer layer];
+    _shadow = [CAShapeLayer layer];
+    _halo = [CAGradientLayer layer];
+    _halo.type = kCAGradientLayerRadial;
+    _halo.startPoint = CGPointMake(0.5, 0.5);
+    _halo.endPoint = CGPointMake(1, 1);
+    _edge = [CAShapeLayer layer];
+    _ring = [CAShapeLayer layer];
+    _dot = [CAShapeLayer layer];
+    [_cone addSublayer:_coneEdge];
+    [_cone addSublayer:_coneRing];
+    [_cone addSublayer:_coneFill];
+    // Bottom to top as the app's layers: the cone, a soft shadow, the halo, the dot's edge, ring and fill.
+    [self.layer addSublayer:_cone];
+    [self.layer addSublayer:_shadow];
+    [self.layer addSublayer:_halo];
+    [self.layer addSublayer:_edge];
+    [self.layer addSublayer:_ring];
+    [self.layer addSublayer:_dot];
+    self.style = style;
+  }
+  return self;
+}
+
+- (void)setStyle:(MLRNAppPuckStyle *)style {
+  _style = style;
+  [self layout];
+}
+
+- (void)setDoubt:(BOOL)doubt {
+  if (_doubt == doubt) return;
+  _doubt = doubt;
+  [self paint];
+}
+
+- (void)setConcealed:(BOOL)concealed {
+  _concealed = concealed;
+  self.hidden = concealed;
+}
+
+- (void)setShowsCone:(BOOL)showsCone {
+  _showsCone = showsCone;
+  _cone.hidden = !showsCone;
+}
+
+/** Geometry from the style: paths around the view's centre, the cone pointing up. */
+- (void)layout {
+  MLRNAppPuckStyle *s = _style;
+  CGRect b = self.bounds;
+  CGPoint c = CGPointMake(CGRectGetMidX(b), CGRectGetMidY(b));
+  for (CALayer *l in @[ _cone, _coneFill, _coneEdge, _coneRing, _shadow, _edge, _ring, _dot ]) {
+    l.frame = b;
+  }
+  _cone.anchorPoint = CGPointMake(0.5, 0.5);
+  _cone.position = c;
+  UIBezierPath *(^circle)(double) = ^(double r) {
+    return [UIBezierPath bezierPathWithArcCenter:c radius:r startAngle:0 endAngle:2 * M_PI clockwise:YES];
+  };
+  double outer = s.r + s.ringWidth + s.edgeWidth;
+  // The dot's soft shadow (the app's: black at 22 %, blurred, 2 pt down) as a layer shadow with no fill of its own.
+  _shadow.path = nil;
+  _shadow.fillColor = [UIColor clearColor].CGColor;
+  _shadow.shadowPath = circle(outer + 2).CGPath;
+  _shadow.shadowColor = [UIColor blackColor].CGColor;
+  _shadow.shadowOpacity = 0.22;
+  _shadow.shadowRadius = 2.5;
+  _shadow.shadowOffset = CGSizeMake(0, 2);
+  // The halo fades out over its outer part (the app's `circle-blur`).
+  _halo.frame = CGRectMake(c.x - s.haloR, c.y - s.haloR, 2 * s.haloR, 2 * s.haloR);
+  _halo.locations = @[ @0, @0.6, @1 ];
+  _edge.path = circle(outer).CGPath;
+  _ring.path = circle(s.r + s.ringWidth).CGPath;
+  _dot.path = circle(s.r).CGPath;
+  double half = s.coneHalfDeg * M_PI / 180;
