+static UIColor *MLRNColorFromARGB(id value, UIColor *fallback) {
+  if (![value isKindOfClass:[NSNumber class]]) return fallback;
+  uint32_t v = (uint32_t)[value unsignedLongLongValue];
+  CGFloat a = ((v >> 24) & 0xFF) / 255.0;
+  CGFloat r = ((v >> 16) & 0xFF) / 255.0;
+  CGFloat g = ((v >> 8) & 0xFF) / 255.0;
+  CGFloat b = (v & 0xFF) / 255.0;
+  return [UIColor colorWithRed:r green:g blue:b alpha:a];
+}
+
+static double MLRNNumber(id value, double fallback) {
+  return [value isKindOfClass:[NSNumber class]] ? [value doubleValue] : fallback;
+}
+
+@implementation MLRNFedLocationManager
+
+@synthesize delegate = _delegate;
+@synthesize headingOrientation = _headingOrientation;
