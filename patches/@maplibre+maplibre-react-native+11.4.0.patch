+  [sector moveToPoint:c];
+  [sector addArcWithCenter:c radius:s.coneR startAngle:-M_PI_2 - half endAngle:-M_PI_2 + half clockwise:YES];
+  [sector closePath];
+  _coneFill.path = sector.CGPath;
+  _coneEdge.path = sector.CGPath;
+  _coneRing.path = sector.CGPath;
+  _coneEdge.fillColor = nil;
+  _coneRing.fillColor = nil;
+  _coneEdge.lineWidth = s.coneEdge * 2;
+  _coneRing.lineWidth = s.coneRing * 2;
+  _coneEdge.lineJoin = kCALineJoinRound;
+  _coneRing.lineJoin = kCALineJoinRound;
