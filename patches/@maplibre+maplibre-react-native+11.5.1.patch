+- (void)feedAppUserLocationLat:(double)lat
+                           lon:(double)lon
+                     courseDeg:(double)courseDeg
+                      speedMps:(double)speedMps
+                     accuracyM:(double)accuracyM
+                        leadMs:(double)leadMs
+                         flags:(NSInteger)flags
+                   coneHalfDeg:(double)coneHalfDeg {
+  if (!_appUserLocation || !_appLocationManager) return;
+  BOOL snap = (flags & 1) != 0;
+  BOOL doubt = (flags & 2) != 0;
+  BOOL hidden = (flags & 4) != 0;
+  MLRNAppPuckView *puck = [self appPuckView];
+  if (puck) {
+    puck.doubt = doubt;
+    puck.concealed = hidden;
+    puck.showsCone = !isnan(courseDeg);
+    puck.coneHalfDeg = coneHalfDeg;
+  }
+  _appPuckDoubt = doubt;
+  _appPuckHidden = hidden;
+  _appConeHalfDeg = coneHalfDeg;
+  // MapLibre eases the dot and the follow camera linearly over the gap between two locations' timestamps (capped at
+  // a second), and reads them for nothing else. Moving, the pose is predicted `leadMs` ahead and stamped that long
+  // after the one before, so each ease lands where the car is when it gets there, however close together two feeds
+  // come (a publish and the next step can be a millisecond apart: stamped with the clock, the second ease is a jump).
+  // Standing (no lead), the ease spans the time since the last feed.
+  NSDate *now = [NSDate date];
+  NSTimeInterval ease = leadMs > 0 ? leadMs / 1000.0 : (_appFedAt ? [now timeIntervalSinceDate:_appFedAt] : 0);
+  NSDate *stamp = [(_appStamp ?: now) dateByAddingTimeInterval:MIN(MAX(ease, 1.0 / 60), 1.0)];
+  _appStamp = stamp;
+  _appFedAt = now;
+  // MapLibre's user location keeps no location at the very spot of the one before (MLNUserLocation's setLocation:):
+  // a turn alone (the walking compass, a heading set at a stop) reached neither the cone nor the heading-up camera. It
+  // is fed 1e-9° (about 0.1 mm) off that spot.
+  CLLocation *shown = self.userLocation.location;
+  double course = isnan(courseDeg) ? -1 : courseDeg;
+  if (!snap && shown && shown.coordinate.latitude == lat && shown.coordinate.longitude == lon && shown.course != course) {
+    lat += 1e-9;
+  }
+  CLLocation *location = [[CLLocation alloc] initWithCoordinate:CLLocationCoordinate2DMake(lat, lon)
+                                                       altitude:0
+                                             horizontalAccuracy:isnan(accuracyM) ? -1 : accuracyM
+                                               verticalAccuracy:-1
+                                                         course:course
+                                                          speed:isnan(speedMps) ? -1 : speedMps
+                                                      timestamp:stamp];
