+    // and comes back: neither is the driver's doing, JS hears neither.
+    MLNUserTrackingMode mode = self.userTrackingMode;
+    [self withQuietTracking:^{
+      self.showsUserLocation = NO;
+      self.showsUserLocation = YES;
+      [self->_appLocationManager feed:location];
+      if (mode != MLNUserTrackingModeNone) [self setUserTrackingMode:mode animated:NO completionHandler:nil];
+    }];
+    return;
+  }
+  [_appLocationManager feed:location];
+}
