{
  "expo": {
    "name": "wtf.ai",
    "slug": "wtf-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wtfai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ai.wtf.navigator",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "wtf.ai downloads offline maps from your computer on the local network (developer map source)."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121211",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "ai.wtf.navigator"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/android-build.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "toolsButton": false,
          "showMenuAtLaunch": false,
          "skipOnboarding": true,
          "ios": {
            "embeddedBundle": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F4F1",
          "image": "./assets/images/splash-light.png",
          "imageWidth": 300,
          "dark": {
            "backgroundColor": "#121211",
            "image": "./assets/images/splash-dark.png"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow wtf.ai to use your location while navigating.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-localization",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      [
        "./modules/vehicle-link/app.plugin.js",
        {
          "mfiProtocols": [
            "com.obdlink",
            "com.vgatemall"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "note": "Set SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT to upload source maps; otherwise set SENTRY_DISABLE_AUTO_UPLOAD=true."
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-asset"
    ],
    "locales": {
      "en": "./locales/en.json",
      "uk": "./locales/uk.json",
      "ru": "./locales/uk.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e95ceda-2c3e-46cf-8eab-1146ec0b499c"
      }
    }
  }
}
